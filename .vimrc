" General
syntax on
set encoding=utf-8
set backspace=indent,eol,start
set mouse=a

" UI & Line numbers
set number
set cursorline
set scrolloff=8
set showcmd
set ruler

" Indentation (2 spaces)
set tabstop=2
set shiftwidth=2
set softtabstop=2
set expandtab
set autoindent
set smartindent

" Search
set incsearch
set hlsearch
set ignorecase
set smartcase

" Misc
set termguicolors
set wildmenu
set updatetime=300
